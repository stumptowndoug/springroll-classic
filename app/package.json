    "ai": "7.0.42",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.34",
    "mermaid": "^11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.27.0",
    "zod": "4.4.3"
  },
