{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!desktop/target",
      "!!desktop/gen",
      "!!.local",
      "!!**/dist",
      "!!coverage",
      "!!docs/design",
      "!!docs/legacy-spring-roll",
      "!!drizzle",
      "!!docs/google-verification-evidence/openrouter-zdr-endpoints.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
